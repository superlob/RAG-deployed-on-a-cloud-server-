# ============================================================
# 环境变量配置模板
# 复制为 rag.env 后填入实际值：cp rag.env.example rag.env
# ============================================================

# 数据库配置
DB_HOST=<your-db-host>
DB_PORT=5432
DB_NAME=rag_paper_db
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>

# JWT 配置
JWT_SECRET_KEY=<generate-a-random-secret-key>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 服务器配置
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false

# ============================================================
# LLM 配置说明：
# - 文本嵌入（向量化）：使用阿里云百炼 (DashScope) 的 qwen3.7-text-embedding 模型
# - 聊天对话：使用 gpt-6-luna 模型（通过 OpenAI 兼容接口）
# ============================================================

# 阿里云百炼 (DashScope) - 用于文本嵌入
DASHSCOPE_API_KEY=<your-dashscope-api-key>

# 聊天模型 (OpenAI 兼容接口) - 用于对话生成
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_BASE_URL=<your-openai-base-url>
CHAT_MODEL=gpt-6-luna

# 检索模式
RETRIEVAL_MODE=real
